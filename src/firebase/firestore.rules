rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /sites/{siteId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      function isSignedIn() { return request.auth != null; }
      function isAdmin() { return isSignedIn() && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role == 'admin'; }

      match /works/{workId} {
        allow read, write: if isAdmin() || (isSignedIn() && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role == 'staff');
        match /materials/{matId} {
          allow read: if isSignedIn();
          allow write: if isAdmin() || (isSignedIn() && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role == 'staff');
        }
      }
    }
    match /users/{userId} {
      allow read: if request.auth.uid == userId;
      allow write: if isAdmin();
    }
  }
}
